{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "chat-simulator",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@bukuwa/worker",
        "dev:chat"
      ],
      "port": 8788
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "@bukuwa/web",
        "dev:sim"
      ],
      "port": 3000
    }
  ]
}
