DATABASE_URL=postgres://bukuwa_worker:change-me@localhost:5432/bukuwa
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_GRAPH_API_VERSION=v21.0
# openssl rand -base64 32
PII_HMAC_KEY=
PII_ENC_KEY=
PRIVACY_POLICY_URL=https://bukuwa.id/privasi
# Must equal PRIVACY_VERSION in apps/web/lib/privacy.ts (v2 discloses AI processing abroad)
CONSENT_VERSION=2026-11-v2
TRIAL_DAYS=14
DEFAULT_TIMEZONE=Asia/Jakarta
# Anthropic credentials (or an `ant auth login` profile)
ANTHROPIC_API_KEY=
AI_ROUTER_MODEL=claude-haiku-5-5
AI_ROUTER_EFFORT=low
AI_EXTRACTOR_MODEL=claude-haiku-5-5
AI_EXTRACTOR_EFFORT=low
AI_LOW_CONFIDENCE_THRESHOLD=0.7
# Photos and PDFs (receipts, transfer screenshots, invoices)
AI_VISION_MODEL=claude-sonnet-5-5
AI_VISION_EFFORT=low
AI_VISION_MAX_IMAGE_BYTES=5242880
# Original photos and voice notes, kept as evidence
MEDIA_DIR=./data/media
MEDIA_MAX_BYTES=16777216
# Questions and corrections (tool-calling agent)
AI_AGENT_MODEL=claude-sonnet-5-5
AI_AGENT_EFFORT=low
# Signed report / evidence links (F10). Same REPORT_LINK_KEY as apps/api.
PUBLIC_BASE_URL=https://api.example.com
REPORT_LINK_KEY=
REPORT_LINK_TTL_MINUTES=15
EVIDENCE_LINK_TTL_HOURS=168
# Tax rules live in the tax_profiles table; this only picks the default regime.
TAX_DEFAULT_REGIME=umkm_final_individual
TAX_NOTICE_LOCAL_TIME=08:00
# Dashboard magic links (milestone 7)
WEB_BASE_URL=https://app.example.com
LOGIN_LINK_TTL_MINUTES=15
ADMIN_LOGIN_TTL_MINUTES=10
# Staff numbers allowed into the admin console, comma-separated
ADMIN_PHONES=
# Milestone 8: cost monitoring and limits
# Model prices, integer milli-USD per million tokens; defaults are in packages/ai/src/pricing.ts
# AI_PRICES_JSON={"claude-haiku-5-5":{"input":100,"output":500,"cacheRead":10,"cacheWrite":125}}
IDR_PER_USD=16500
COST_ALERT_MONTHLY_IDR=3000
# Meta's current rate for one utility template message in Indonesia, in rupiah (check the rate card)
WA_TEMPLATE_COST_IDR=
DAILY_INBOUND_LIMIT=300
# Pilot: new numbers need an invite code (create codes in the admin console)
PILOT_INVITE_REQUIRED=true
# "hapus data": days before the erasure runs
ERASURE_GRACE_DAYS=7
