DATABASE_URL=postgres://bukuwa_worker:change-me@localhost:5432/bukuwa
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_GRAPH_API_VERSION=v21.0
# openssl rand -base64 32
PII_HMAC_KEY=
PII_ENC_KEY=
PRIVACY_POLICY_URL=https://bukuwa.id/privasi
CONSENT_VERSION=2026-11-v1
TRIAL_DAYS=14
DEFAULT_TIMEZONE=Asia/Jakarta
# Anthropic credentials (or an `ant auth login` profile)
ANTHROPIC_API_KEY=
AI_ROUTER_MODEL=claude-haiku-5-5
AI_ROUTER_EFFORT=low
AI_EXTRACTOR_MODEL=claude-haiku-5-5
AI_EXTRACTOR_EFFORT=low
AI_LOW_CONFIDENCE_THRESHOLD=0.7
# Photos and PDFs (receipts, transfer screenshots, invoices)
AI_VISION_MODEL=claude-sonnet-5-5
AI_VISION_EFFORT=low
AI_VISION_MAX_IMAGE_BYTES=5242880
# Original photos and voice notes, kept as evidence
MEDIA_DIR=./data/media
MEDIA_MAX_BYTES=16777216
# Questions and corrections (tool-calling agent)
AI_AGENT_MODEL=claude-sonnet-5-5
AI_AGENT_EFFORT=low
# Signed report / evidence links (F10). Same REPORT_LINK_KEY as apps/api.
PUBLIC_BASE_URL=https://api.example.com
REPORT_LINK_KEY=
REPORT_LINK_TTL_MINUTES=15
EVIDENCE_LINK_TTL_HOURS=168
# Tax rules live in the tax_profiles table; this only picks the default regime.
TAX_DEFAULT_REGIME=umkm_final_individual
TAX_NOTICE_LOCAL_TIME=08:00
